# Case PM Windows Server settings
# Copy to instance\server.env (WINDOWS-SERVER-SETUP.bat creates this automatically)

CASEPM_HOST=0.0.0.0
CASEPM_PORT=5000
CASEPM_REMOTE=1
CASEPM_DEBUG=0

# Optional: restrict Windows Firewall to your office subnet (e.g. 192.168.1.0/24)
# CASEPM_LAN_SUBNET=192.168.1.0/24

# Optional: portable Java used for MS Project MPP import (set automatically by INSTALL-JAVA-FOR-MPP.bat)
# CASEPM_JAVA_HOME=vendor\java

# When you add HTTPS via IIS/nginx later:
# CASEPM_HTTPS=1
# CASEPM_BEHIND_PROXY=1
# CASEPM_ALLOWED_HOSTS=casepm.yourcompany.com
